#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: MeshCentral
# Starts MeshCentral
# ==============================================================================
bashio::log.info "Starting MeshCentral..."

export NODE_ENV=production

# Set log level if configured
declare log_level
log_level=$(bashio::config "log_level")
if bashio::var.has_value "${log_level}"; then
  export DEBUG="${log_level}"
fi

# Ensure data directories exist (defensive in case init step failed)
if ! bashio::fs.directory_exists "/share/meshcentral/meshcentral-data"; then
  mkdir -p /share/meshcentral/meshcentral-data
fi

if ! bashio::fs.directory_exists "/share/meshcentral/meshcentral-backups"; then
  mkdir -p /share/meshcentral/meshcentral-backups
fi

# Default domains configuration (always needed)
# "allowedorigin": true disables MeshCentral's WebSocket Origin check. Without it,
# the management WebSocket (/control.ashx) is rejected with cause "invalidorigin"
# ("Invalid origin in HTTP request, click to reconnect") whenever the add-on is
# reached by an IP/hostname that differs from the auto-generated certificate
# CommonName -- which is the normal case for a Home Assistant add-on.
DEFAULT_DOMAINS='{"": {"title": "MeshCentral", "minify": true, "newAccounts": true, "allowedorigin": true, "myServer": {"Backup": true, "Restore": true}}}'

# Check if custom config is provided via addon option
declare meshcentral_config
meshcentral_config=$(bashio::config "meshcentral_config")

# Handle meshcentral_config option if provided
if bashio::var.has_value "${meshcentral_config}"; then
  # Validate that it's not empty/whitespace/null
  if [[ "${meshcentral_config}" =~ ^[[:space:]]*$ ]] || [[ "${meshcentral_config}" == "null" ]]; then
    bashio::log.warning "meshcentral_config is empty or null, ignoring it"
    meshcentral_config=""
  else
    # Check if config file exists and content matches (skip validation if unchanged)
    if [ -s "/share/meshcentral/meshcentral-data/config.json" ]; then
      # Quick hash comparison to avoid expensive validation if unchanged
      CONFIG_HASH=$(echo -n "${meshcentral_config}" | md5sum | cut -d' ' -f1)
      if [ -f "/share/meshcentral/meshcentral-data/.config_hash" ]; then
        STORED_HASH=$(cat "/share/meshcentral/meshcentral-data/.config_hash" 2>/dev/null || echo "")
        if [ "${CONFIG_HASH}" == "${STORED_HASH}" ]; then
          bashio::log.info "meshcentral_config unchanged, skipping validation"
          meshcentral_config=""
        fi
      fi
    fi
    
    if bashio::var.has_value "${meshcentral_config}"; then
      bashio::log.info "Validating and applying custom MeshCentral configuration..."
      # Validate JSON and ensure domains section exists using Node.js
      VALIDATED_CONFIG=$(node -e "
        const defaultDomains = JSON.parse(process.argv[2]);
        try {
          const config = JSON.parse(process.argv[1]);
          if (!config.domains || typeof config.domains !== 'object') {
            config.domains = defaultDomains;
          }
          console.log(JSON.stringify(config, null, 2));
        } catch (e) {
          console.error('Invalid JSON:', e.message);
          process.exit(1);
        }
      " "${meshcentral_config}" "${DEFAULT_DOMAINS}" 2>&1)
      VALIDATE_EXIT=$?
      
      if [ ${VALIDATE_EXIT} -eq 0 ] && [ -n "${VALIDATED_CONFIG}" ]; then
        echo "${VALIDATED_CONFIG}" > /share/meshcentral/meshcentral-data/config.json
        echo -n "${CONFIG_HASH}" > /share/meshcentral/meshcentral-data/.config_hash
        bashio::log.info "Custom configuration validated and written successfully"
      else
        bashio::log.error "Invalid JSON in meshcentral_config option: ${VALIDATED_CONFIG}"
        bashio::log.error "Keeping existing configuration (if any) instead of overwriting"
        bashio::exit.nok "Invalid meshcentral_config JSON. Please check your configuration."
      fi
    fi
  fi
fi

# Only write default config if config.json doesn't exist or is empty
if [ ! -s "/share/meshcentral/meshcentral-data/config.json" ]; then
  bashio::log.info "Writing default MeshCentral configuration..."
  cat > /share/meshcentral/meshcentral-data/config.json <<EOF
{
  "settings": {
    "port": 443,
    "redirPort": 80,
    "mpsPort": 44330,
    "relayPort": 453,
    "allowLoginToken": true,
    "allowFraming": true,
    "agentPing": 60,
    "agentPong": 60,
    "minify": true,
    "webRTC": true
  },
  "domains": ${DEFAULT_DOMAINS}
}
EOF
else
  bashio::log.info "Using existing MeshCentral configuration..."
fi

# Backfill the "Invalid origin in HTTP request" fix into existing installs.
# MeshCentral rejects the management WebSocket (cause "invalidorigin") when the
# browser Origin hostname does not match the certificate name; "allowedorigin": true
# on a domain disables that check. New configs get it from the default/option paths
# above. This step runs against the final config.json regardless of how it was
# produced, and adds the key to the default domain ("") only when it is absent --
# an explicit "allowedorigin" of any value (including false) is left untouched, and
# named domains are not modified. The file is rewritten only when something changed.
if [ -s "/share/meshcentral/meshcentral-data/config.json" ]; then
  NORMALIZE_RESULT=$(node -e '
    const fs = require("fs");
    const file = process.argv[1];
    let config;
    try { config = JSON.parse(fs.readFileSync(file, "utf8")); }
    catch (e) { console.error(e.message); process.exit(1); }
    const d = config.domains;
    if (!d || typeof d !== "object" || !d[""] || typeof d[""] !== "object") { console.log("NOCHANGE"); process.exit(0); }
    const hasKey = Object.keys(d[""]).some(function (k) { return k.toLowerCase() === "allowedorigin"; });
    if (hasKey) { console.log("NOCHANGE"); process.exit(0); }
    d[""].allowedorigin = true;
    fs.writeFileSync(file, JSON.stringify(config, null, 2));
    console.log("UPDATED");
  ' "/share/meshcentral/meshcentral-data/config.json" 2>&1)
  if [ $? -eq 0 ]; then
    if [ "${NORMALIZE_RESULT}" == "UPDATED" ]; then
      bashio::log.info 'Added "allowedorigin": true to the default domain to prevent "Invalid origin in HTTP request" errors'
    fi
  else
    bashio::log.warning "Could not normalize config.json, leaving it unchanged: ${NORMALIZE_RESULT}"
  fi
fi

# Set data directory
export MESHCENTRAL_DATA="/share/meshcentral/meshcentral-data"
export MESHCENTRAL_FILES="/share/meshcentral/meshcentral-files"

# MeshCentral is installed as a dependency of the /opt/meshcentral npm project
# rather than globally; see the Dockerfile for why that matters.
meshcentral_home="/opt/meshcentral"
meshcentral_app="${meshcentral_home}/node_modules/meshcentral"

cd "${meshcentral_app}" \
    || bashio::exit.nok "Could not change directory to MeshCentral"

# Make sure MeshCentral's pinned modules are all installed before handing over.
# MeshCentral checks them itself on every start and shells out to "npm install"
# for anything it considers missing; if that install fails it prints
# "Unable to install required modules" and exits with status 0, which s6 reads as
# a clean exit and restarts -- a crash loop with no failed state to notice. The
# image ships a complete set, so a failure here means the install was damaged.
declare verify_output
declare verify_status
verify_output=$(node /usr/local/bin/meshcentral-verify-modules.js "${meshcentral_app}" 2>&1)
verify_status=$?

if [ ${verify_status} -eq 2 ]; then
  bashio::exit.nok "Could not check the MeshCentral installation: ${verify_output}"
elif [ ${verify_status} -eq 3 ]; then
  # Everything is on disk, but MeshCentral's own check disagrees and will
  # reinstall those modules before starting. That is harmless here -- the
  # install runs inside the /opt/meshcentral project -- but log what its check
  # saw, since it costs a registry round trip on every start.
  bashio::log.warning "MeshCentral will reinstall modules it already has:"
  while IFS= read -r line; do
    bashio::log.warning "  ${line}"
  done <<< "${verify_output}"
elif [ ${verify_status} -ne 0 ]; then
  # Status 1 means "these modules are missing", one name@version per line. Node
  # itself also exits 1 when it cannot run the script at all, so make sure the
  # output really is a module list before handing it to npm.
  if [ ${verify_status} -ne 1 ] \
    || ! grep -qE '^@?[A-Za-z0-9._/-]+@[0-9]' <<< "${verify_output}" \
    || grep -qvE '^@?[A-Za-z0-9._/-]+@[0-9][A-Za-z0-9.+-]*$' <<< "${verify_output}"; then
    bashio::exit.nok "Could not check the MeshCentral installation: ${verify_output}"
  fi

  bashio::log.warning "MeshCentral modules missing: ${verify_output//$'\n'/ }"
  bashio::log.warning "Installing them now, this requires internet access..."

  # Run from the project root, the way MeshCentral itself would.
  # shellcheck disable=SC2086
  (cd "${meshcentral_home}" && npm install --no-audit --no-fund --omit=optional --save-exact ${verify_output}) \
    || bashio::log.error "npm could not install the missing modules."

  verify_output=$(node /usr/local/bin/meshcentral-verify-modules.js "${meshcentral_app}" 2>&1)
  verify_status=$?
  if [ ${verify_status} -eq 1 ] || [ ${verify_status} -eq 2 ]; then
    bashio::log.error "MeshCentral is still missing: ${verify_output//$'\n'/ }"
    bashio::log.error "Rebuild the add-on (uninstall and reinstall it) to restore them."
    bashio::exit.nok "Refusing to start MeshCentral with an incomplete installation"
  fi
  bashio::log.info "Missing modules installed successfully"
fi

# Recorded for the finish script, which uses it to tell a real run apart from an
# immediate exit (MeshCentral exits with status 0 on several fatal start paths).
date +%s > /run/meshcentral.start

exec node meshcentral.js --datapath /share/meshcentral/meshcentral-data
